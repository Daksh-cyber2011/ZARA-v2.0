# MYRAA environment configuration (copy to .env and fill in)
# The Gemini API key can also be entered in the app's Settings panel on first
# run; it is stored in the per-user data directory, never shipped with the app.
GEMINI_API_KEY=YOUR_KEY_HERE

# Optional overrides
# MYRAA_DATA_DIR=/path/to/writable/data/dir
# DESKTOP_AGENT_URL=http://127.0.0.1:8765
# DESKTOP_OBSERVER_URL=http://127.0.0.1:8766
# MYRAA_AGENT_EXE=/path/to/myraa-agent.exe
# MYRAA_PYTHON=/path/to/python
# MYRAA_PUBLIC_APIS_URL=https://raw.githubusercontent.com/dabidstudio/dabidstudio-public-apis/master/public_apis.json
